<Project Sdk="Dalamud.NET.SDK/15.0.0">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Version>0.0.6.1</Version>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Tests\**" />
		<None Remove="Tests\**" />
	</ItemGroup>

	<Target Name="UpdatePluginRepository" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
		<PropertyGroup>
			<RepositoryJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/repo.template.json').Replace('__VERSION__', '$(Version)'))</RepositoryJson>
		</PropertyGroup>
		<WriteLinesToFile File="$(MSBuildProjectDirectory)/repo.json" Lines="$(RepositoryJson)" Overwrite="true" Encoding="UTF-8" WriteOnlyWhenDifferent="true" />
	</Target>

</Project>
